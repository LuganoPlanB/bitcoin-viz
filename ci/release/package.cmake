include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
archive_name(name "${PLATFORM}" "${ARCH}")
foreach(required STAGE OUTPUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
get_filename_component(stage "${STAGE}" ABSOLUTE)
get_filename_component(output "${OUTPUT}" ABSOLUTE)
set(binary bitcoin-viz)
if(PLATFORM STREQUAL "windows")
  string(APPEND binary .exe)
endif()
foreach(required "bin/${binary}" "share/bitcoin-viz/LICENSE" "share/bitcoin-viz/nlohmann-LICENSE.MIT")
  if(NOT EXISTS "${stage}/${required}" OR IS_DIRECTORY "${stage}/${required}")
    message(FATAL_ERROR "Installed file missing: ${required}")
  endif()
endforeach()
if(DEFINED DEPENDENCIES)
  set(licenses "${stage}/share/bitcoin-viz/third-party")
  file(MAKE_DIRECTORY "${licenses}")
  file(GLOB copyrights "${DEPENDENCIES}/share/*/copyright")
  foreach(copyright IN LISTS copyrights)
    get_filename_component(parent "${copyright}" DIRECTORY)
    get_filename_component(dependency "${parent}" NAME)
    configure_file("${copyright}" "${licenses}/${dependency}.txt" COPYONLY)
  endforeach()
  foreach(required curl openssl sqlite3 zeromq)
    if(NOT EXISTS "${licenses}/${required}.txt")
      message(FATAL_ERROR "Dependency license missing: ${required}")
    endif()
  endforeach()
endif()
git(commit rev-parse HEAD)
file(READ "${SOURCE_DIR}/vcpkg.json" dependencies)
string(JSON baseline GET "${dependencies}" builtin-baseline)
file(WRITE "${stage}/MANIFEST.json"
  "{\n  \"version\": \"${VERSION}\",\n  \"tag\": \"v${VERSION}\",\n  \"commit\": \"${commit}\",\n  \"platform\": \"${PLATFORM}\",\n  \"architecture\": \"${ARCH}\",\n  \"executable\": \"bin/${binary}\",\n  \"dependency_baseline\": \"${baseline}\"\n}\n")
file(WRITE "${stage}/VERSION" "${VERSION}\n")
file(WRITE "${stage}/SOURCE.txt"
  "Corresponding source: https://github.com/luganoplanb/bitcoin-viz/tree/${commit}\nBuild instructions and exact dependency source pins: docs/RELEASING.md, vcpkg.json, and ci/.\n")
configure_file("${SOURCE_DIR}/README.md" "${stage}/README.md" COPYONLY)
string(REGEX REPLACE "\\.(tar\\.gz|zip)$" "" prefix "${name}")
set(work "${output}/.package-${PLATFORM}-${ARCH}")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/${prefix}")
file(COPY "${stage}/" DESTINATION "${work}/${prefix}")
if(PLATFORM STREQUAL "windows")
  set(tar_options cf "${output}/${name}" --format=zip)
else()
  set(tar_options czf "${output}/${name}" --format=gnutar)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar ${tar_options} -- "${prefix}"
  WORKING_DIRECTORY "${work}" RESULT_VARIABLE result)
file(REMOVE_RECURSE "${work}")
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Archive creation failed: ${name}")
endif()
message(STATUS "Packaged ${output}/${name}")
