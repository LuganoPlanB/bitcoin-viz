cmake_minimum_required(VERSION 3.20)
get_filename_component(PROJECT_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT DEFINED SOURCE_DIR)
  set(SOURCE_DIR "${PROJECT_ROOT}")
endif()
if(NOT VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
  message(FATAL_ERROR "VERSION must be strict major.minor.patch")
endif()
find_package(Git REQUIRED QUIET)
function(git output)
  execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN} WORKING_DIRECTORY "${SOURCE_DIR}"
    RESULT_VARIABLE result OUTPUT_VARIABLE value ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "git ${ARGN}: ${error}")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()
function(archive_name output platform arch)
  if(NOT "${platform}/${arch}" MATCHES "^(linux|macos)/(x86_64|arm64)$|^windows/x86_64$")
    message(FATAL_ERROR "Unknown release target: ${platform}/${arch}")
  endif()
  set(suffix .tar.gz)
  if(platform STREQUAL "windows")
    set(suffix .zip)
  endif()
  set(${output} "bitcoin-viz-v${VERSION}-${platform}-${arch}${suffix}" PARENT_SCOPE)
endfunction()
