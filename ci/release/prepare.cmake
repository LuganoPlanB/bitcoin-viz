include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
git(head rev-parse HEAD)
if(NOT head STREQUAL BASE)
  message(FATAL_ERROR "Release candidate must start at BASE")
endif()
git(dirty status --porcelain --untracked-files=no)
if(NOT dirty STREQUAL "")
  message(FATAL_ERROR "Release candidate requires a clean tracked checkout")
endif()
if(NOT DEFINED BUNDLE OR BUNDLE STREQUAL "")
  message(FATAL_ERROR "BUNDLE is required")
endif()
file(WRITE "${SOURCE_DIR}/VERSION" "${VERSION}\n")
git(unused add VERSION)
git(changed diff --cached --name-only)
if(NOT changed STREQUAL "")
  git(unused -c "user.name=github-actions[bot]"
    -c "user.email=41898282+github-actions[bot]@users.noreply.github.com"
    commit -m "chore(release): v${VERSION} [skip ci]")
endif()
git(candidate rev-parse HEAD)
get_filename_component(bundle "${BUNDLE}" ABSOLUTE)
get_filename_component(parent "${bundle}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}")
git(unused bundle create "${bundle}.tmp" HEAD)
file(RENAME "${bundle}.tmp" "${bundle}")
if(DEFINED ENV{GITHUB_OUTPUT} AND NOT "$ENV{GITHUB_OUTPUT}" STREQUAL "")
  file(APPEND "$ENV{GITHUB_OUTPUT}" "commit=${candidate}\n")
endif()
message(STATUS "Release candidate: ${candidate}")
