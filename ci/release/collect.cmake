include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
if(NOT COMMIT MATCHES "^[0-9a-f]+$" OR NOT DEFINED DIRECTORY OR DIRECTORY STREQUAL "")
  message(FATAL_ERROR "COMMIT and DIRECTORY are required")
endif()
get_filename_component(DIRECTORY "${DIRECTORY}" ABSOLUTE)
set(expected)
foreach(platform linux macos windows)
  foreach(arch x86_64 arm64)
    if(platform STREQUAL "windows" AND arch STREQUAL "arm64")
      continue()
    endif()
    archive_name(name "${platform}" "${arch}")
    list(APPEND expected "${name}")
  endforeach()
endforeach()
file(GLOB found RELATIVE "${DIRECTORY}" "${DIRECTORY}/*.tar.gz" "${DIRECTORY}/*.zip")
list(SORT found)
list(SORT expected)
if(NOT found STREQUAL expected)
  message(FATAL_ERROR "Release asset set differs. Expected: ${expected}; found: ${found}")
endif()
set(checksums "")
foreach(name IN LISTS expected)
  string(REGEX REPLACE "\\.(tar\\.gz|zip)$" "" prefix "${name}")
  string(REGEX MATCH "-(linux|macos|windows)-(x86_64|arm64)\\." target "${name}")
  set(platform "${CMAKE_MATCH_1}")
  set(arch "${CMAKE_MATCH_2}")
  set(binary bitcoin-viz)
  if(platform STREQUAL "windows")
    string(APPEND binary .exe)
  endif()
  set(work "${DIRECTORY}/.verify-${platform}-${arch}")
  file(REMOVE_RECURSE "${work}")
  file(ARCHIVE_EXTRACT INPUT "${DIRECTORY}/${name}" DESTINATION "${work}"
    PATTERNS "${prefix}/MANIFEST.json" "${prefix}/bin/${binary}")
  if(NOT EXISTS "${work}/${prefix}/MANIFEST.json" OR NOT EXISTS "${work}/${prefix}/bin/${binary}")
    message(FATAL_ERROR "Artifact manifest or executable missing: ${name}")
  endif()
  file(READ "${work}/${prefix}/MANIFEST.json" manifest LIMIT 65536)
  foreach(field version commit platform architecture executable)
    string(JSON actual_${field} GET "${manifest}" "${field}")
  endforeach()
  file(REMOVE_RECURSE "${work}")
  if(NOT actual_version STREQUAL VERSION OR NOT actual_commit STREQUAL COMMIT
      OR NOT actual_platform STREQUAL platform OR NOT actual_architecture STREQUAL arch
      OR NOT actual_executable STREQUAL "bin/${binary}")
    message(FATAL_ERROR "Artifact manifest mismatch: ${name}")
  endif()
  file(SHA256 "${DIRECTORY}/${name}" digest)
  string(APPEND checksums "${digest}  ${name}\n")
endforeach()
file(WRITE "${DIRECTORY}/SHA256SUMS" "${checksums}")
message(STATUS "Verified all five release archives and wrote SHA256SUMS")
