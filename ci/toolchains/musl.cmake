set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR "$ENV{BITCOIN_VIZ_MUSL_PROCESSOR}")
if(NOT EXISTS "$ENV{BITCOIN_VIZ_MUSL_CC}" OR NOT EXISTS "$ENV{BITCOIN_VIZ_MUSL_CXX}")
  message(FATAL_ERROR "Set BITCOIN_VIZ_MUSL_CC and BITCOIN_VIZ_MUSL_CXX to dyne/musl-action outputs")
endif()
set(CMAKE_C_COMPILER "$ENV{BITCOIN_VIZ_MUSL_CC}")
set(CMAKE_CXX_COMPILER "$ENV{BITCOIN_VIZ_MUSL_CXX}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
