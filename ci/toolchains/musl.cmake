set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR "$ENV{BWC_MUSL_PROCESSOR}")
if(NOT EXISTS "$ENV{BWC_MUSL_CC}" OR NOT EXISTS "$ENV{BWC_MUSL_CXX}")
  message(FATAL_ERROR "Set BWC_MUSL_CC and BWC_MUSL_CXX to dyne/musl-action outputs")
endif()
set(CMAKE_C_COMPILER "$ENV{BWC_MUSL_CC}")
set(CMAKE_CXX_COMPILER "$ENV{BWC_MUSL_CXX}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
