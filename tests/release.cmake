cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED TEST_ROOT OR TEST_ROOT STREQUAL "")
  message(FATAL_ERROR "TEST_ROOT is required")
endif()
find_package(Git REQUIRED QUIET)
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/source" "${TEST_ROOT}/assets")
set(source "${TEST_ROOT}/source")
function(command)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${source}" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${ARGN} failed (${result}): ${output}${error}")
  endif()
  string(STRIP "${output}" output)
  set(output "${output}" PARENT_SCOPE)
endfunction()
function(reject_script script)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${source}" ${ARGN} -P "${root}/ci/release/${script}.cmake"
    WORKING_DIRECTORY "${source}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0)
    message(FATAL_ERROR "Expected rejection: ${script} ${ARGN}")
  endif()
endfunction()
file(WRITE "${source}/VERSION" "0.1.0\n")
file(WRITE "${source}/README.md" "Fixture\n")
configure_file("${root}/vcpkg.json" "${source}/vcpkg.json" COPYONLY)
command("${GIT_EXECUTABLE}" init -b main)
command("${GIT_EXECUTABLE}" add .)
command("${GIT_EXECUTABLE}" -c user.name=Fixture -c user.email=fixture@example.org commit -m initial)
command("${GIT_EXECUTABLE}" rev-parse HEAD)
set(base "${output}")
set(bundle "${TEST_ROOT}/candidate.bundle")
reject_script(prepare -DVERSION=01.2.3 "-DBASE=${base}" "-DBUNDLE=${bundle}")
reject_script(prepare -DVERSION=1.2.3 -DBASE=0000000 "-DBUNDLE=${bundle}")
file(APPEND "${source}/README.md" "dirty\n")
reject_script(prepare -DVERSION=1.2.3 "-DBASE=${base}" "-DBUNDLE=${bundle}")
command("${GIT_EXECUTABLE}" checkout -- README.md)
command("${CMAKE_COMMAND}" "-DSOURCE_DIR=${source}" -DVERSION=1.2.3 "-DBASE=${base}" "-DBUNDLE=${bundle}"
  -P "${root}/ci/release/prepare.cmake")
command("${GIT_EXECUTABLE}" bundle verify "${bundle}")
command("${GIT_EXECUTABLE}" rev-parse HEAD)
set(commit "${output}")
file(READ "${source}/VERSION" version)
if(NOT version STREQUAL "1.2.3\n" OR commit STREQUAL base)
  message(FATAL_ERROR "Candidate did not update version and commit")
endif()
# Reusing the same version must not create a second commit.
command("${CMAKE_COMMAND}" "-DSOURCE_DIR=${source}" -DVERSION=1.2.3 "-DBASE=${commit}" "-DBUNDLE=${bundle}"
  -P "${root}/ci/release/prepare.cmake")
command("${GIT_EXECUTABLE}" rev-parse HEAD)
if(NOT output STREQUAL commit)
  message(FATAL_ERROR "Candidate preparation is not idempotent")
endif()
set(stage "${TEST_ROOT}/stage with spaces")
set(assets "${TEST_ROOT}/assets")
set(dependencies "${TEST_ROOT}/deps")
file(MAKE_DIRECTORY "${stage}/bin" "${stage}/share/bitcoin-viz")
foreach(dependency curl openssl sqlite3 zeromq)
  file(WRITE "${dependencies}/share/${dependency}/copyright" "Fixture ${dependency} license\n")
endforeach()
reject_script(package -DVERSION=1.2.3 -DPLATFORM=linux -DARCH=x86_64 "-DSTAGE=${stage}" "-DOUTPUT=${assets}")
file(WRITE "${stage}/bin/bitcoin-viz" "Fixture executable\n")
file(WRITE "${stage}/bin/bitcoin-viz.exe" "Fixture executable\n")
configure_file("${root}/LICENSE" "${stage}/share/bitcoin-viz/LICENSE" COPYONLY)
configure_file("${root}/third_party/nlohmann/LICENSE.MIT" "${stage}/share/bitcoin-viz/nlohmann-LICENSE.MIT" COPYONLY)
reject_script(package -DVERSION=1.2.3 -DPLATFORM=linux -DARCH=x86_64 "-DSTAGE=${stage}"
  "-DOUTPUT=${assets}" "-DDEPENDENCIES=${TEST_ROOT}/missing")
foreach(platform linux macos windows)
  foreach(arch x86_64 arm64)
    if(platform STREQUAL "windows" AND arch STREQUAL "arm64")
      continue()
    endif()
    command("${CMAKE_COMMAND}" "-DSOURCE_DIR=${source}" -DVERSION=1.2.3 "-DPLATFORM=${platform}" "-DARCH=${arch}"
      "-DSTAGE=${stage}" "-DOUTPUT=${assets}" "-DDEPENDENCIES=${dependencies}"
      -P "${root}/ci/release/package.cmake")
  endforeach()
endforeach()
reject_script(collect -DVERSION=1.2.3 -DCOMMIT=0000000 "-DDIRECTORY=${assets}")
file(RELATIVE_PATH relative_assets "${source}" "${assets}")
command("${CMAKE_COMMAND}" "-DSOURCE_DIR=${source}" -DVERSION=1.2.3 "-DCOMMIT=${commit}" "-DDIRECTORY=${relative_assets}"
  -P "${root}/ci/release/collect.cmake")
file(STRINGS "${assets}/SHA256SUMS" sums)
list(LENGTH sums count)
if(NOT count EQUAL 5)
  message(FATAL_ERROR "Expected five checksums")
endif()
foreach(sum IN LISTS sums)
  string(SUBSTRING "${sum}" 0 64 expected)
  string(SUBSTRING "${sum}" 66 -1 name)
  file(SHA256 "${assets}/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Checksum mismatch: ${name}")
  endif()
endforeach()
file(REMOVE "${assets}/bitcoin-viz-v1.2.3-linux-arm64.tar.gz")
reject_script(collect -DVERSION=1.2.3 "-DCOMMIT=${commit}" "-DDIRECTORY=${assets}")
file(REMOVE_RECURSE "${TEST_ROOT}")
message(STATUS "Release tools: versions, dirty/base guards, bundle, repeat preparation, five archives, licenses, manifests, checksums and missing-asset rejection passed")
